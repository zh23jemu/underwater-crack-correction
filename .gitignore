# Python 解释器、缓存和测试运行态
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 项目本地虚拟环境与本机配置
.venv/
venv/
env/
.env
.env.*
.vscode/
.idea/
.tools/
external_methods/

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
*.swp
*.swo

# 日志与临时运行文件
*.log
slurm-*.out
slurm-*.err
tmp_synth_in/
tmp_synth_out/
output_smoke_local*/

# 大型数据集与训练产物。
# 这些内容后续通过 GitHub Release assets 或外部对象存储分发，不进入 Git 历史。
underwater_crack_v3/
under-crack-images/
output_crackwarp/
release_assets/

# 深度学习训练中容易膨胀的模型权重与 checkpoint。
# 小型评估结果、CSV、JSON、图片报告默认不整体忽略，便于后续分析和汇报。
*.pth
*.pt
*.ckpt
*.onnx
